{
  "name": "minecraft-blocks-render",
  "description": "Renders 3D-like icon from 2D sprite",
  "version": "4.0.0",
  "repository": "https://github.com/TABmk/minecraft-blocks-render.git",
  "keywords": [
    "minecraft"
  ],
  "author": "TAB_mk <tabmk.contact[at]gmail.com>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "MODE=dev vite dev --host",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint ."
  },
  "devDependencies": {
    "@eslint/compat": "1.4.0",
    "@eslint/js": "9.36.0",
    "@sveltejs/adapter-auto": "6.1.0",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.43.2",
    "@sveltejs/vite-plugin-svelte": "6.2.0",
    "@tailwindcss/typography": "0.5.18",
    "@tailwindcss/vite": "4.1.13",
    "@threlte/core": "^8.3.0",
    "@threlte/extras": "^9.7.1",
    "@threlte/studio": "^0.2.1",
    "@types/jquery": "^3.5.30",
    "@types/jstree": "^3.3.46",
    "@types/node": "22",
    "@types/three": "^0.181.0",
    "daisyui": "^5.5.5",
    "eslint": "9.36.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.12.4",
    "globals": "16.4.0",
    "highlight.js": "^11.11.1",
    "jszip": "^3.10.1",
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "3.4.0",
    "prettier-plugin-tailwindcss": "0.6.14",
    "svelte": "5.39.5",
    "svelte-check": "4.3.2",
    "svelte-file-dropzone": "^2.0.9",
    "tailwindcss": "4.1.13",
    "three": "^0.181.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "typograf": "7.6.0",
    "vite": "7.1.7"
  },
  "dependencies": {
    "github-buttons": "^2.29.1",
    "heroicons-svelte": "^2.0.2",
    "jquery": "^3.7.1",
    "jstree": "^3.3.15"
  }
